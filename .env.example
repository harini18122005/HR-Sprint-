# Placeholder only. Put the real key in your local .env or deployment environment.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-astra

# Public frontend setting. Set this to the backend origin used by the browser.
PEOPLEDESK_API_BASE_URL=http://127.0.0.1:8000

# Comma-separated browser origins allowed to call the backend.
FRONTEND_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
